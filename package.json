{
  "name": "hermes-trading-floor",
  "version": "0.1.0",
  "private": true,
  "description": "An agentic trading desk: a floor of AI agents you watch, instruct and approve. Paper trading only.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djroken/Hermes-Trading-Floor.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.9",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "concurrently -n web,core -c cyan,yellow \"pnpm dev:web\" \"pnpm dev:core\"",
    "dev:web": "pnpm --filter web dev",
    "dev:core": "pnpm --filter core dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
