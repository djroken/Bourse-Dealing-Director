# Copy to .env (never commit .env). Every variable here is optional.

# Hermes Core (apps/core)
# Interface to bind. Keep 127.0.0.1 unless you put authentication in front of it:
# core has no login, and anyone who can reach it can read the floor and halt the agents.
CORE_HOST=127.0.0.1
CORE_PORT=4000

# Browser origins allowed to open the /agents WebSocket and call state-changing endpoints.
# Comma-separated. Requests with no Origin header (curl, scripts) are allowed.
CORE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Encrypted key store (optional). Without a master key, core refuses to store secrets.
# Generate one with:  pnpm --filter core keygen
# Lose it and stored keys cannot be recovered. Never commit it.
# HERMES_MASTER_KEY=
# Where the encrypted file (secrets.json) lives. Default: .hermes in core's working directory (git-ignored).
# HERMES_DATA_DIR=.hermes

# Real models (optional). A seat whose model id starts with ollama:, openrouter: or openrouter-free: asks that model.
# Model seats only ever suggest. They never place an order on their own.
# OLLAMA_HOST=http://127.0.0.1:11434
# OpenRouter key: save it in Setup (needs HERMES_MASTER_KEY) or export it here. Used by openrouter: and openrouter-free:.
# OPENROUTER_API_KEY=
# Model calls per UTC day, per provider (0 = unlimited). Ollama defaults to unlimited, OpenRouter to 200.
# OLLAMA_DAILY_CAP=0
# OPENROUTER_DAILY_CAP=200

# Note: core does not load .env files itself. Export these in your shell (or use a tool such as direnv).
