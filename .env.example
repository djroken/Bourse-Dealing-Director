# Copy to .env (never commit .env). Every variable here is optional.

# Hermes Core (apps/core)
# Interface to bind. Keep 127.0.0.1 unless you put authentication in front of it:
# core has no login, and anyone who can reach it can read the floor and halt the agents.
CORE_HOST=127.0.0.1
CORE_PORT=4000

# Browser origins allowed to open the /agents WebSocket and call state-changing endpoints.
# Comma-separated. Requests with no Origin header (curl, scripts) are allowed.
CORE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
