# Copy to .env in the repo folder (never commit .env). Core reads it on start. Every variable here is optional.

# Bourse Core (apps/core)
# Interface to bind. Keep 127.0.0.1 unless you put authentication in front of it:
# core has no login, and anyone who can reach it can read the floor and halt the agents.
CORE_HOST=127.0.0.1
CORE_PORT=4000

# Browser origins allowed to open the /agents WebSocket and call state-changing endpoints.
# Comma-separated. Requests with no Origin header (curl, scripts) are allowed.
CORE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Encrypted key store (optional). Without a master key, core refuses to store secrets.
# Generate one with:  pnpm --filter core keygen
# Lose it and stored keys cannot be recovered. Never commit it.
# BOURSE_MASTER_KEY=
# Where the encrypted file (secrets.json) lives. Default: .bourse in core's working directory (git-ignored).
# BOURSE_DATA_DIR=.bourse

# Real models (optional). A seat whose model id starts with ollama:, openrouter: or openrouter-free: asks that model.
# Model seats only ever suggest. They never place an order on their own.
# OLLAMA_HOST=http://127.0.0.1:11434
# OpenRouter key: save it in Setup (step 02), or put it here. Used by openrouter: and openrouter-free:.
# OPENROUTER_API_KEY=
# Model calls per UTC day, per provider (0 = unlimited). Ollama defaults to unlimited, OpenRouter to 200.
# OLLAMA_DAILY_CAP=0
# OPENROUTER_DAILY_CAP=200
# Free OpenRouter models share one budget (OpenRouter allows 50/day without credits, 1000 with $10+). Free seats talk in floor rounds only.
# OPENROUTER_FREE_DAILY_CAP=45
# BOURSE_FREE_BACKGROUND=off

# Floor conversation: the agents talk a round every this many minutes (0 = only when you instruct the floor). Default 15.
# Each model seat makes one call per round; on paid OpenRouter models that costs money.
# BOURSE_TALK_MIN=15
# Each model call in a round (prompt, reply, idea) is appended to <BOURSE_DATA_DIR>/talk.jsonl. Set to off to disable.
# BOURSE_TALK_LOG=on

# Scorecards: each idea is scored against the price this many minutes later (1 to 1440). Default 15.
# BOURSE_SCORE_HORIZON_MIN=15
# Scored ideas are appended to <BOURSE_DATA_DIR>/ideas.jsonl for evaluation or fine-tuning. Set to off to disable.
# BOURSE_IDEA_LOG=on

# Paper books, scorecards and seat settings are kept in <BOURSE_DATA_DIR>/state.json across restarts. Set to off to disable.
# BOURSE_PERSIST=on

# Markets. Crypto (BTC, ETH, SOL, BNB, XRP) needs nothing. Add coins with a Binance USDT market:
# BOURSE_CRYPTO=DOGE,ADA
# US stocks need a free Alpaca paper-account key (market data; also paper trading if you set BOURSE_VENUE_STOCKS below).
# Save it in Setup, or export it here. Default tickers SPY,AAPL,NVDA,TSLA.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# BOURSE_STOCKS=SPY,AAPL,NVDA,TSLA

# News: public RSS/Atom feeds for headlines (default CoinDesk, Cointelegraph, Decrypt, Federal Reserve). https only, max 8; off to disable.
# BOURSE_NEWS_FEEDS=CoinDesk=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# Broker paper accounts (play money, sandboxes only). Orders you approve go there instead of core's paper venue.
# BOURSE_VENUE_CRYPTO=binance-testnet
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# BOURSE_VENUE_STOCKS=alpaca-paper

# MCP for guest agents (optional). Without a token, /mcp is off. 16+ random characters; treat it like a password.
# Generate one with:  openssl rand -hex 24
# BOURSE_MCP_TOKEN=

# This project was called Hermes before. The old HERMES_* names (and ./.hermes) still work; BOURSE_* wins when both are set.

# Note: core does not load .env files itself. Export these in your shell (or use a tool such as direnv).
